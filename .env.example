# LiveKit Configuration
# Get from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

# ============================================================================
# NOTE: With LiveKit Cloud, you DON'T need separate API keys!
# LiveKit provides access to OpenAI and Deepgram through your LiveKit account.
# Just sign up at https://cloud.livekit.io and use the credentials above.
# ============================================================================

# Interruption Handler Configuration (optional)
# Comma-separated list of words to ignore while agent is speaking
FILLER_WORDS=yeah,ok,okay,hmm,uh-huh,mhm,right,aha,sure,yep,yup,got it

# Comma-separated list of words that always trigger interruption
INTERRUPT_WORDS=wait,stop,no,hold,pause,hold on,hang on

# Enable debug logging for interruption handler
INTERRUPTION_DEBUG=true
