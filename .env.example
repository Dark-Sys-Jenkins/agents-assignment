# LiveKit credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI Provider Keys
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# ===== INTELLIGENT INTERRUPTION CONFIGURATION =====
# Customize which words are treated as backchanneling (passive acknowledgment)
# Agent will continue speaking seamlessly when these words are detected
# Format: comma-separated list (no spaces)
BACKCHANNELING_WORDS=yeah,yep,yup,ok,okay,alright,sure,right,mhm,gotcha,understood,correct,exactly,absolutely,definitely,indeed,true,aha,hmm,uh-huh,mm-hmm

# Customize which words trigger immediate interruption
# Agent will stop immediately when any of these words are detected
# Format: comma-separated list (no spaces)
INTERRUPT_WORDS=stop,wait,no,hold,pause,cancel,halt,cease,but