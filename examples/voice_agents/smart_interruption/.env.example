# Required for all examples
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# LLM - Groq (FREE - no credit card required)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# STT - Deepgram (required for Speech to Text)
DEEPGRAM_API_KEY=your-deepgram-key-here

# TTS - Azure Speech (FREE - 500k chars/month)
# Get your key at: https://azure.microsoft.com/en-us/products/cognitive-services/speech-services
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=eastus

# Optional: Custom word lists
# SMART_INTERRUPT_PASSIVE_WORDS=yeah,okay,mhm,right
# SMART_INTERRUPT_COMMAND_WORDS=stop,wait,hold on
